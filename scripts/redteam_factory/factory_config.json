{
  "output_root": "data/redteam/factory",
  "script_sources": [
    "data/scam_corpus/corpus_v0.1.jsonl",
    "data/redteam/scam_scripts.jsonl"
  ],
  "speaker_ref_root": "data/redteam",
  "dialects": ["mandarin", "minnan", "sichuan", "cantonese", "dongbei", "henan"],
  "channels": ["clean", "phone8k", "mp3_16k", "amr", "noise"],
  "engines": [
    {
      "name": "edgetts",
      "display": "Edge-TTS",
      "kind": "edgetts",
      "attack_prefix": "RT-EDGETTS",
      "license": "微软服务条款，仅研究评测用途",
      "voices": {
        "mandarin": ["zh-CN-YunxiNeural", "zh-CN-XiaoxiaoNeural", "zh-CN-YunjianNeural", "zh-CN-YunyangNeural"],
        "sichuan": ["zh-CN-YunxiNeural", "zh-CN-XiaoxiaoNeural"],
        "dongbei": ["zh-CN-liaoning-XiaobeiNeural"],
        "henan": ["zh-CN-shaanxi-XiaoniNeural"],
        "cantonese": ["zh-HK-HiuMaanNeural", "zh-HK-WanLungNeural"],
        "minnan": ["zh-TW-HsiaoChenNeural", "zh-TW-YunJheNeural"]
      },
      "voice_notes": "已按 2026-09-03 --list-voices 实际目录校准：sichuan/henan 无原生音色（henan 以陕西腔近似），sichuan 回落普通话音色+方言文本，minnan 以台湾国语近似，dongbei=辽宁腔，cantonese=粤港音色"
    },
    {
      "name": "sovits_api",
      "display": "GPT-SoVITS(v2 API, GPU 批处理)",
      "kind": "sovits_api",
      "url": "http://127.0.0.1:9880/tts",
      "attack_prefix": "RT-SOVITS",
      "probe_path": "external/GPT-SoVITS/api_v2.py",
      "license": "MIT",
      "note": "需先启动 api_v2 服务: D:/VeriCall_data/conda_envs/gpt-sovits/python.exe api_v2.py -a 127.0.0.1 -p 9880 -c GPT_SoVITS/configs/tts_infer.yaml；参考音自举自 edgetts 产物(data/redteam/refs.json)"
    },
    {
      "name": "sovits",
      "display": "GPT-SoVITS",
      "kind": "cli",
      "attack_prefix": "RT-SOVITS",
      "cmd": "python external/GPT-SoVITS/inference_cli.py --ref_audio {ref} --ref_text {ref_text} --text {text} --output {out}",
      "probe_path": "external/GPT-SoVITS/inference_cli.py",
      "license": "MIT"
    },
    {
      "name": "cosyvoice",
      "display": "CosyVoice",
      "kind": "cli",
      "attack_prefix": "RT-COSY",
      "cmd": "python external/CosyVoice/cli_infer.py --prompt_wav {ref} --prompt_text {ref_text} --tts_text {text} --output {out}",
      "probe_path": "external/CosyVoice/cli_infer.py",
      "license": "学术用途，以 LICENSE 文件为准"
    },
    {
      "name": "seedvc",
      "display": "Seed-VC",
      "kind": "cli",
      "attack_prefix": "RT-SEEDVC",
      "cmd": "python external/Seed-VC/inference.py --source {source_wav} --target {ref} --output {out}",
      "probe_path": "external/Seed-VC/inference.py",
      "license": "未标注，使用前自查 LICENSE"
    }
  ],
  "cell_limits": {
    "scripts_per_dialect": 40,
    "refs_per_dialect": 4
  }
}
