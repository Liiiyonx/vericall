# ============================================================
# 谛听 VeriCall · 环境变量模板
# 用法：cp .env.example .env 后按实际情况修改
# 解析优先级：环境变量 > 项目根 .env > src/paths.py 代码默认值
# 查看当前生效配置：python -c "from src.paths import report; print(report())"
# ============================================================

# ---------- 路径（按你的实际位置修改，建议放在仓库外） ----------
VERICALL_DATA_ROOT=/path/to/vericall_data
# VERICALL_MODELS_ROOT=/path/to/vericall_data/models
# VERICALL_ASVSPOOF_LA=/path/to/ASVspoof2019_LA
# VERICALL_LA_ZIP=/path/to/LA.zip
# VERICALL_PARQUET_DIR=/path/to/parquet
# VERICALL_SENSEVOICE_DIR=/path/to/SenseVoiceSmall
# VERICALL_XLSR_MODEL=/path/to/xlsr_model
# VERICALL_AASIST_DIR=./external/aasist
# VERICALL_AASIST_EXP=LA_AASIST
VERICALL_HISTORY_DIR=./data/history

# ---------- 密钥文件（也可直接写下面的环境变量） ----------
# 该文件内以 KEY=VALUE 形式提供密钥，勿提交到版本库
# VERICALL_SECRETS_FILE=/path/to/vericall_secrets.env

# ---------- 云端 LLM（语义通道；不填则回退规则评分器） ----------
# VERICALL_SEMANTIC_LLM=cloud
# SCAM_LLM_BASE=https://api.deepseek.com
# SCAM_LLM_KEY=
# SCAM_LLM_MODEL=deepseek-chat

# ---------- 运行设备与监听 ----------
# VERICALL_DEVICE=cuda:0
# VERICALL_HOST=127.0.0.1
# VERICALL_PORT=8000
# VERICALL_OFFLINE=0

# ---------- 演示账号（正式部署请关闭并轮换口令） ----------
# VERICALL_DEMO_ACCOUNT=1
# VERICALL_DEMO_USERNAME=DemoChild
# VERICALL_DEMO_PASSWORD=
# VERICALL_EXPOSE_DEMO_CREDENTIALS=0
# VERICALL_ALLOW_REGISTRATION=1

# ---------- 安全边界 ----------
# VERICALL_TRUST_PROXY_HEADERS=0
# VERICALL_ALLOW_REMOTE_INVITE=0
# VERICALL_ENABLE_DOCS=0
# VERICALL_LOGIN_MAX_TRACKED_IDENTITIES=4096
# VERICALL_MAX_UPLOAD_MB=25

# ---------- 流式与通话限额 ----------
# VERICALL_MAX_STREAM_CONNECTIONS=4
# VERICALL_MAX_STREAM_FRAME_MB=2
# VERICALL_MAX_CALL_CONNECTIONS=8
# VERICALL_MAX_CALL_FRAME_MB=2
# VERICALL_MAX_CALL_CONTROL_KB=16

# ---------- 家庭与号码库 ----------
# VERICALL_FAMILY_ID=demo-family
# VERICALL_NUMBER_BLOCKLIST=./data/numbers/blocklist.txt
# VERICALL_FAMILY_NUMBER_BLOCKLIST=./data/numbers/family_blocklist.jsonl
