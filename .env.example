# 谛听 VeriCall · 环境配置模板
# 用法：复制本文件为 .env，按需修改。所有项都有默认值，不配也能跑。

# ---------------------------------------------------------------- 数据区
# 数据集 / 模型 / 训练日志的大文件根目录。数据集约 6GB，别放系统盘。
VERICALL_DATA_ROOT=D:/VeriCall_data

# 模型权重根目录（默认 DATA_ROOT/models）
# VERICALL_MODELS_ROOT=D:/VeriCall_data/models

# ASVspoof2019 LA 解压后的 LA 目录（内含 flac/ 与 protocol 文件）
# VERICALL_ASVSPOOF_LA=D:/VeriCall_data/ASVspoof2019_LA/LA

# 数据集压缩包 / parquet 中间产物 / 冒烟测试集
# VERICALL_LA_ZIP=D:/VeriCall_data/LA.zip
# VERICALL_PARQUET_DIR=D:/VeriCall_data/parquet
# VERICALL_SMOKE_ROOT=D:/VeriCall_data/smoke_ASVspoof2019_LA

# ---------------------------------------------------------------- 模型
# FunASR SenseVoiceSmall 本地目录（离线 ASR 转写）
# VERICALL_SENSEVOICE_DIR=D:/VeriCall_data/models/SenseVoiceSmall

# clovaai/aasist 的 clone 位置与实验名
# VERICALL_AASIST_DIR=./external/aasist
# VERICALL_AASIST_EXP=LA_AASIST_5060_ep24_bs16

# Ollama 服务地址与风险评分模型（通道③话术分析依赖）
# VERICALL_OLLAMA_HOST=http://localhost:11434
# VERICALL_OLLAMA_MODEL=deepseek-r1:8b

# ---------------------------------------------------------------- 运行时
# 推理设备：cuda / cpu
# VERICALL_DEVICE=cuda
# 演示服务端口
# VERICALL_PORT=8000
