# 谛听 VeriCall · 环境配置模板
# 用法：复制本文件为 .env，按需修改。所有项都有默认值，不配也能跑。

# ---------------------------------------------------------------- 数据区
# 数据集 / 模型 / 训练日志的大文件根目录。数据集约 6GB，别放系统盘。
VERICALL_DATA_ROOT=D:/VeriCall_data

# 模型权重根目录（默认 DATA_ROOT/models）
# VERICALL_MODELS_ROOT=D:/VeriCall_data/models

# ASVspoof2019 LA 解压后的 LA 目录（内含 flac/ 与 protocol 文件）
# VERICALL_ASVSPOOF_LA=D:/VeriCall_data/ASVspoof2019_LA/LA

# 数据集压缩包 / parquet 中间产物 / 冒烟测试集
# VERICALL_LA_ZIP=D:/VeriCall_data/LA.zip
# VERICALL_PARQUET_DIR=D:/VeriCall_data/parquet
# VERICALL_SMOKE_ROOT=D:/VeriCall_data/smoke_ASVspoof2019_LA

# 外部 secrets 文件（可选；默认 DATA_ROOT/secrets/vericall_secrets.env）
# 敏感 key/token 不要提交到 Git，也不要写入日志。
# VERICALL_SECRETS_FILE=D:/VeriCall_data/secrets/vericall_secrets.env

# 家庭检测历史分片目录（默认 data/history；相对路径按项目根解析）
# 旧 data/history.jsonl 保持只读兼容，可用 scripts/migrate_history_shards.py 迁移
# VERICALL_HISTORY_DIR=./data/history

# ---------------------------------------------------------------- 模型
# FunASR SenseVoiceSmall 本地目录（离线 ASR 转写）
# VERICALL_SENSEVOICE_DIR=D:/VeriCall_data/models/SenseVoiceSmall

# XLS-R 中文域声学通道模型目录
# VERICALL_XLSR_MODEL=D:/VeriCall_data/models/wav2vec2-xls-r-300m

# 声学主通道：xlsr_cn:wide（默认，中文 TTS/克隆 + 声码器宽覆盖）
# 可选：xlsr_cn:v4（红队母本检出略高） / aasist（英文基线回退）
VERICALL_ACOUSTIC=xlsr_cn:wide

# clovaai/aasist 的 clone 位置与实验名
# VERICALL_AASIST_DIR=./external/aasist
# VERICALL_AASIST_EXP=LA_AASIST_5060_ep24_bs16

# 语义后端：cloud（默认，需要 SCAM_LLM_KEY）| ollama（显式备用）
# VERICALL_SEMANTIC_LLM=cloud
# SCAM_LLM_BASE=https://api.deepseek.com/v1
# SCAM_LLM_MODEL=deepseek-chat

# Ollama 服务地址与风险评分模型（通道③话术分析依赖）
# VERICALL_OLLAMA_HOST=http://localhost:11434
# VERICALL_OLLAMA_MODEL=deepseek-r1:8b

# ---------------------------------------------------------------- 运行时
# 推理设备：cuda / cpu
# VERICALL_DEVICE=cuda
# 演示服务端口
# VERICALL_PORT=8000
# 服务监听地址（手机访问子女端时可设 0.0.0.0）
# VERICALL_HOST=127.0.0.1
# 本机默认家庭 ID（多家庭部署分别为不同设备设置不同值）
# VERICALL_FAMILY_ID=demo
# 离线缓存演示；仅显式设为 1 时启用
# VERICALL_OFFLINE=0
# 是否允许非本机发起守护呼叫（默认仅本机）
# VERICALL_ALLOW_REMOTE_INVITE=0

# ---------------------------------------------------------------- 公网安全
# 仅在同机反向代理会清洗并覆盖转发头时开启；应用直接暴露公网时必须保持 0
# VERICALL_TRUST_PROXY_HEADERS=0
# API 文档默认关闭；仅在隔离的开发环境临时设为 1
# VERICALL_ENABLE_DOCS=0
# 是否开放子女端自助注册；正式部署建议设为 0，由管理员预建账号
# VERICALL_ALLOW_REGISTRATION=1
# 是否显示演示账号入口；正式部署建议设为 0（不会删除已有演示账号）
# VERICALL_DEMO_ACCOUNT=1
# 演示账号用户名；本机未设置密码时自动生成并由页面显示，公网默认隐藏
# VERICALL_DEMO_USERNAME=DemoChild
# VERICALL_DEMO_PASSWORD=
# 仅本机演示会自动显示凭据；如需公网展示一键填入，再显式设为 1。
# VERICALL_EXPOSE_DEMO_CREDENTIALS=1
# 登录失败身份缓存上限；超出后按最旧键淘汰，防止大量伪造 IP/用户名占用内存
# VERICALL_LOGIN_MAX_TRACKED_IDENTITIES=4096
# 单次上传上限（MB），非法值自动回退到 25
# VERICALL_MAX_UPLOAD_MB=25
# 同时活跃的流式连接数与单帧上限；非法值自动回退到安全默认
# VERICALL_MAX_STREAM_CONNECTIONS=4
# VERICALL_MAX_STREAM_FRAME_MB=2
# 公开涉诈号码库与家庭私有举报库；家庭举报只对当前 family_id 生效
# VERICALL_NUMBER_BLOCKLIST=./data/numbers/blocklist.txt
# VERICALL_FAMILY_NUMBER_BLOCKLIST=./data/numbers/family_blocklist.jsonl
# 同时活跃的 /ws/call 连接数、音频帧与控制帧上限；非法值回退到安全默认
# VERICALL_MAX_CALL_CONNECTIONS=8
# VERICALL_MAX_CALL_FRAME_MB=2
# VERICALL_MAX_CALL_CONTROL_KB=16
